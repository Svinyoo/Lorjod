// Copy this file to Local.xcconfig. It is ignored by Git.
// Change the prefix to a unique reverse-domain identifier you control.
PARKLY_BUNDLE_PREFIX = com.yourcompany.parkly
DEVELOPMENT_TEAM = YOUR_TEAM_ID
// xcconfig treats // as a comment; $() preserves the second slash.
// Set your real HTTPS server before making a Release archive.
PARKLY_SERVER_URL = https:/$()/parkly.example.com
// For Debug you may leave PARKLY_SERVER_URL empty and enter it in the app.
